#!/bin/sh
# The @taskloop/tl launcher.
#
# tl is a compiled Lean binary, not JavaScript. This package holds no code of
# its own: it declares one optional dependency per platform, npm installs the
# single one that matches, and this script execs it.
#
# A POSIX shell script rather than a Node shim, deliberately. Node would add
# ~30ms of interpreter startup to a CLI whose own commands run in single-digit
# milliseconds, and it would put a JavaScript runtime between the user and a
# formally verified binary for no benefit. `exec` also means the binary
# *replaces* this process: signals, exit status, stdin/stdout/stderr, and job
# control all belong to tl directly, with no forwarding layer to get wrong.
#
# There is no `postinstall`. Nothing here downloads anything at install time
# (ADR-0006 / ADR-0014 T3): the binaries arrive as ordinary npm tarballs whose
# integrity the registry client already checks, from packages pinned to an
# exact version. An install-time download would be an unverified fetch running
# with the user's privileges, which is the supply-chain hole this whole
# arrangement exists to avoid.
set -eu

# Resolve this script's real location. npm links bin entries into node_modules/
# .bin (and into a global bin directory for `npm i -g`), so $0 is normally a
# symlink and the package root is not where we were invoked from. Walk the
# symlink chain rather than assuming a layout — `readlink -f` is GNU-only and
# missing on macOS.
target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case $link in
    /*) target=$link ;;
    *) target=$(dirname -- "$target")/$link ;;
  esac
done
here=$(CDPATH='' cd -- "$(dirname -- "$target")" && pwd -P)
# bin/ -> package root
root=$(CDPATH='' cd -- "$here/.." && pwd -P)

# The two mappings below are embedded copies of `rc_detect_os`/`rc_detect_arch`
# in scripts/lib/release-common.sh. The duplication is forced: this script ships
# inside a published npm package and has no access to that repository.
# `scripts/check-embedded-copies.sh` compares the classifications and fails when
# they disagree, since a copy that maps a uname to a different target would
# select the wrong binary rather than fail visibly.
# EMBEDDED-COPY-BEGIN detect_os
case $(uname -s) in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW* | MSYS* | CYGWIN* | Windows_NT)
    echo "tl: native Windows is not supported — tl's filesystem primitives are unimplemented there, so a binary would start but could not safely create or mutate task state. Run tl inside WSL2, where the linux-x64 package installs and is fully supported." >&2
    exit 1
    ;;
  *)
    echo "tl: unsupported operating system '$(uname -s)'. tl publishes binaries for Linux and macOS; build from source with Lean 4 if you need another platform (see the repository README)." >&2
    exit 1
    ;;
esac
# EMBEDDED-COPY-END detect_os

# EMBEDDED-COPY-BEGIN detect_arch
case $(uname -m) in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=x64 ;;
  *)
    echo "tl: unsupported CPU architecture '$(uname -m)'. tl publishes arm64 and x64 binaries; build from source with Lean 4 if you need another architecture (see the repository README)." >&2
    exit 1
    ;;
esac
# EMBEDDED-COPY-END detect_arch

pkg="tl-bin-$os-$arch"

# Two layouts, because installers disagree about where an optional dependency
# lands: npm hoists it beside us under node_modules/@taskloop/, while a version
# conflict or a nesting installer can put it under our own node_modules/.
binary=''
for candidate in \
  "$root/../$pkg/bin/tl" \
  "$root/node_modules/@taskloop/$pkg/bin/tl"; do
  if [ -x "$candidate" ]; then
    binary=$candidate
    break
  fi
done

if [ -z "$binary" ]; then
  # Say which of the several causes this is, rather than one message that fits
  # none of them. The common ones: --omit=optional; a lockfile resolved on
  # another platform; and npm having selected by the architecture of the Node
  # that ran the install, which need not be this shell's architecture (an x64
  # Node under Rosetta on an arm64 Mac installs the x64 package).
  installed=''
  for candidate in "$root"/../tl-bin-*/bin/tl "$root"/node_modules/@taskloop/tl-bin-*/bin/tl; do
    [ -x "$candidate" ] || continue
    name=$(basename -- "$(dirname -- "$(dirname -- "$candidate")")")
    installed="$installed $name"
  done
  echo "tl: no binary for $os-$arch — @taskloop/$pkg is not installed." >&2
  if [ -n "$installed" ]; then
    echo "tl: what is installed:${installed}. npm selects a platform package using the architecture of the Node process that ran the install, which is not necessarily this shell's; reinstall using a Node built for $os-$arch (on macOS, check whether Node is running under Rosetta with 'node -p process.arch')." >&2
  else
    echo "tl: reinstall without omitting optional dependencies — 'npm install @taskloop/tl' pulls in exactly one platform package, and that is where the binary lives." >&2
  fi
  exit 1
fi

# glibc, not musl: the Linux binaries are dynamically linked against glibc, and
# the manifests declare "libc": ["glibc"] so npm refuses the install on musl.
# A package manager that ignores that field would otherwise reach `exec`, where
# a missing ELF interpreter surfaces as "not found" naming a file that plainly
# exists.
if [ "$os" = linux ] && [ ! -e /lib64/ld-linux-x86-64.so.2 ] && [ ! -e /lib/ld-linux-aarch64.so.1 ]; then
  for musl in /lib/ld-musl-*.so.1; do
    if [ -e "$musl" ]; then
      echo "tl: this system uses musl libc, and the published Linux binaries are linked against glibc. tl has no musl build yet. Use a glibc-based image (for example node:22-slim rather than node:22-alpine), or build from source with Lean 4." >&2
      exit 1
    fi
  done
fi

exec "$binary" "$@"
