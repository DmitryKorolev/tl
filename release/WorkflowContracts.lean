/- Reviewed workflow capabilities and argv. These values are independent of the
   workflow being checked; a workflow edit cannot grant itself a new capability. -/
import release.WorkflowPolicy
namespace Release.WorkflowPolicy

def releaseContract : Contract := {
  header := [("concurrency", "\n  group: release-${{ github.ref }}\n  cancel-in-progress: false"),
 ("defaults", "\n  run:\n    shell: bash"),
