def ciContract : Contract := {
  header := [("concurrency", "\n  group: ci-${{ github.ref }}\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}"),
 ("defaults", "\n  run:\n    shell: bash"),
 ("name", "CI"),
 ("on", "\n  push:\n    branches: ['**']\n  pull_request:\n  workflow_dispatch:"),
 ("permissions", "\n  contents: read")]
  jobs := [
{ name := "release-policy",
  fields := [("runs-on", "ubuntu-latest"), ("timeout-minutes", "20")],
  closedSteps := false,
  steps := [{ name := "release policy",
              fields := [],
              run := Release.WorkflowPolicy.Run.command
                       { executable := "./.lake/build/bin/tlrelease",
                         arguments := [Release.WorkflowPolicy.Argument.literal "policy",
                                       Release.WorkflowPolicy.Argument.literal "--profile",
                                       Release.WorkflowPolicy.Argument.literal "ci",
                                       Release.WorkflowPolicy.Argument.literal "--strict"] } }],
  references := [] },
{ name := "hermetic-release",
  fields := [("runs-on", "ubuntu-latest"), ("timeout-minutes", "20")],
  closedSteps := false,
  steps := [{ name := "build the native hermetic runner",
              fields := [],
              run := .command { executable := "lake", arguments := [
                .literal "build", .literal "tlrelease", .literal "--wfail"] } },
            { name := "runtime-stripped release policy and retained-adapter suites",
              fields := [],
              run := .command { executable := "./.lake/build/bin/tlrelease", arguments := [
                .literal "hermetic", .literal "--root", .literal "."] } }],
  references := [] },
{ name := "homebrew-formula",
  fields := [("runs-on", "macos-latest"), ("timeout-minutes", "20")],
  closedSteps := false,
  steps := [],
  references := [] },
{ name := "build-and-test",
  fields := [("runs-on", "${{ matrix.os }}"),
             ("strategy", "\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, macos-latest]"),
             ("timeout-minutes", "90")],
  closedSteps := false,
  steps := [],
  references := ["steps.deps-src.outputs.cache-hit", "steps.elan-cache.outputs.cache-hit",
                 "steps.mathlib-cache.outputs.cache-hit"] },
{ name := "git-floor",
  fields := [("env",
              "\n      GIT_FLOOR_VERSION: \"2.17.1\"\n      GIT_FLOOR_SHA256: \"79136e7aa83abae4d8a25c8111f113d3c5a63aeb5fd93cc72c26d49c6d5ba65e\""),
             ("needs", "build-and-test"),
             ("runs-on", "ubuntu-latest"),
             ("timeout-minutes", "30")],
  closedSteps := false,
  steps := [],
  references := [] }
] }

def command : Command := optionCommand "workflow-policy" "--root <dir>"
  "Refuse undeclared workflow authority, output edges, commands or action inputs."
  ["--root", "."] [{ name := "root", takesValue := true }]
  (fun options => options.required "root")
  (fun root => do
    let mut failures : List String := []
    for (path, contract) in [(".github/workflows/release.yml", releaseContract), (".github/workflows/ci.yml", ciContract)] do
      let text ← ofIO (readTextFile (root ++ "/" ++ path))
      failures := failures ++ (Check.failures (checks text contract)).map (path ++ ": " ++ ·)
    if !failures.isEmpty then decline (String.intercalate "\n" failures)
    return "both workflows match their reviewed authority and invocation schemas")

end Release.WorkflowPolicy
